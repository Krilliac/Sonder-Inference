# Actual CLI JSON and default-model behavior; no shell or external service needed.
execute_process(COMMAND "${CMAKE_COMMAND}" -E env --unset=SONDER_INFER_BACKEND --unset=SONDER_INFER_MODEL
    "${WORKER_EXECUTABLE}" backends --json --ollama-url http://127.0.0.1:1
    RESULT_VARIABLE rc OUTPUT_VARIABLE output ERROR_VARIABLE errors TIMEOUT 25)
if(NOT rc EQUAL 0)
    message(FATAL_ERROR "backends failed: ${rc}: ${errors}")
endif()
string(JSON count LENGTH "${output}" backends)
math(EXPR last "${count} - 1")
set(found FALSE)
foreach(i RANGE 0 ${last})
    string(JSON name GET "${output}" backends ${i} name)
    if(name STREQUAL "remote-mock")
        set(found TRUE)
        string(JSON synthetic GET "${output}" backends ${i} synthetic)
        string(JSON probed GET "${output}" backends ${i} probed)
        if(NOT synthetic OR probed)
            message(FATAL_ERROR "remote-mock must be synthetic and unprobed by default")
        endif()
    endif()
endforeach()
if(NOT found)
    message(FATAL_ERROR "remote-mock missing from backends JSON")
endif()
execute_process(COMMAND "${WORKER_EXECUTABLE}" models --backend remote-mock --json
    RESULT_VARIABLE rc OUTPUT_VARIABLE output ERROR_VARIABLE errors TIMEOUT 25)
if(NOT rc EQUAL 0)
    message(FATAL_ERROR "models failed: ${rc}: ${errors}")
endif()
string(JSON synthetic GET "${output}" synthetic)
if(NOT synthetic)
    message(FATAL_ERROR "remote-mock models must be synthetic")
endif()
execute_process(COMMAND "${CMAKE_COMMAND}" -E env --unset=SONDER_INFER_MODEL
    "${WORKER_EXECUTABLE}" generate --backend remote-mock --prompt hello --max-tokens 2 --stats json
    RESULT_VARIABLE rc OUTPUT_VARIABLE output ERROR_VARIABLE errors TIMEOUT 25)
if(NOT rc EQUAL 0 OR NOT errors MATCHES "\"synthetic\":true")
    message(FATAL_ERROR "remote-mock default model or stats failed: ${rc}: ${errors}")
endif()
